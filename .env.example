# =============================================================================
# ERFORDERLICH: Datenbank & Auth
# =============================================================================
# Neon Serverless PostgreSQL Connection String
# Format: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Secret für Session-Cookies (mindestens 16 Zeichen, am besten 32+ random)
# Generieren mit: openssl rand -base64 32
AUTH_SECRET=

# Admin-Passwort (wird per SHA-256 gehasht verglichen)
# Generieren mit: echo -n "dein-passwort" | sha256sum
ADMIN_PASSWORD=

# =============================================================================
# OPTIONAL: API-Keys für KI-Modelle (mindestens EINER erforderlich für Chat)
# =============================================================================
# Google AI Studio (Gemini) - KOSTENLOS verfügbar
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY_2=
GOOGLE_GENERATIVE_AI_API_KEY_3=

# OpenRouter (Free Modelle: Nemotron, Gemma, MiniMax, etc.)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Groq (GPT-OSS, sehr schnell) - KOSTENLOS
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Cohere (Command A) - KOSTENLOS
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_API_KEY_2=
COHERE_API_KEY_3=

# OpenAI (bezahlte Modelle: GPT-6 Luna/Sol/Astra)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# =============================================================================
# OPTIONAL: Für Agent-Modus (Repository-Zugriff)
# =============================================================================
# GitHub Personal Access Token mit repo-Rechten
# https://github.com/settings/tokens
GITHUB_TOKEN=