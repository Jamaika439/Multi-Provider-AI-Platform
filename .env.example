# =============================================================================
# ERFORDERLICH: Datenbank und Anmeldung
# =============================================================================
# Neon PostgreSQL. Format: postgresql://user:passwort@host/dbname?sslmode=require
DATABASE_URL=

# Geheimer Text zum Signieren der Login-Cookies (mindestens 16 Zeichen, besser 40+).
# Ändert er sich, werden alle Nutzer abgemeldet.
AUTH_SECRET=

# Passwort für /admin. Wird direkt als Klartext verglichen (kein Hash eintragen).
ADMIN_PASSWORD=

# =============================================================================
# API-Keys (mindestens einer nötig). Ersatz-Keys mit _2 und _3 werden bei
# Fehler 401/402/403/429 automatisch benutzt.
# =============================================================================
# Google AI Studio (Gemini), Gratis-Kontingent gilt pro Google-Projekt
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY_2=
GOOGLE_GENERATIVE_AI_API_KEY_3=

# OpenRouter (Gratis-Modelle mit :free), Limit gilt pro Konto
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# Groq (GPT-OSS)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Cohere (Command A)
COHERE_API_KEY=
COHERE_API_KEY_2=
COHERE_API_KEY_3=

# NVIDIA NIM (Gratis, Key beginnt mit nvapi-), https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=

# Cloudflare Workers AI (Gratis: 10.000 Neurons pro Tag). Der Token braucht die
# Berechtigung "Workers AI". Die Account-ID steht im Cloudflare-Dashboard.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenAI (bezahlt, nur für Admin freigeschaltet)
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# =============================================================================
# Agent-Modus (nur Admin)
# =============================================================================
# Fine-grained Token nur für dieses Repo, Berechtigung "Contents: Read and write"
GITHUB_TOKEN=
